@startuml
autonumber
title US-3 / UC_Payment: Обробка онлайн-оплати

skinparam sequence {
    ArrowColor DeepSkyBlue
    ActorBorderColor DarkBlue
    ActorBackgroundColor LightCyan
    LifeLineBorderColor Grey
    LifeLineBackgroundColor White
    ParticipantBorderColor DarkSlateGray
    ParticipantBackgroundColor LightGrey
}

actor "Клієнт" as Customer #LightCyan
participant "OrderController\n(Контролер)" as OC #LightBlue
participant "PaymentGateway\n(Платіжний шлюз)" as PG #LightSalmon
database "Database\n(БД)" as DB #LightYellow

Customer -> OC : POST /orders/{orderId}/pay
activate OC

OC -> DB : getOrder(orderId)
activate DB
DB --> OC : order(status=PENDING, amount)
deactivate DB

alt [Замовлення в статусі PENDING]
  OC -> PG : createPaymentSession(orderId, amount)
  activate PG
  PG --> OC : paymentSessionUrl
  deactivate PG

  OC --> Customer : 302 Redirect to paymentSessionUrl
  deactivate OC

  Customer -> PG : enterCardAndConfirm(sessionId)
  activate PG

  PG -> OC : paymentCallback(sessionId, status)
  activate OC
  
  alt [status == SUCCESS]
    OC -> DB : updateOrderStatus(orderId, CONFIRMED)
    activate DB
    DB --> OC : updated
    deactivate DB
    OC --> PG : 200 OK
    PG --> Customer : payment result page (success)
  else [status == FAILED]
    OC -> DB : recordPaymentFailure(orderId, error)
    activate DB
    DB --> OC : failureSaved (status stays PENDING)
    deactivate DB
    OC --> PG : 200 OK
    PG --> Customer : payment result page (failure)
  end
  
  deactivate OC
  deactivate PG

else [Замовлення не очікує оплати (інший статус)]
  OC --> Customer : 409 Conflict "Замовлення не очікує оплати"
  deactivate OC
end

@enduml