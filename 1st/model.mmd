erDiagram
    CATEGORY ||--o{ PRODUCT : contains
    CUSTOMER ||--o{ ORDER : places
    ORDER ||--|{ ORDER_ITEM : includes
    PRODUCT ||--|{ ORDER_ITEM : ordered_in

    CUSTOMER {
        string id PK
        string email
        string fullName
        string phoneNumber
        date createdAt
    }    

    CATEGORY{
        string id PK
        string name
        string description
    }
    PRODUCT {
        string id PK
        string categoryId FK 
        string title
        string description
        string brand
        float price
        number stockQuantity
    }
    ORDER {
        string id PK
        string customerId FK
        number totalAmount
        string status
        date createdAt
    }
    ORDER_ITEM {
        string id PK
        number orderId FK
        number productId FK
        number quantity
        float unitPrice
    }